# Extraction output — never commit game data
out/
extracted/
*.extracted/

# Probe output from setup.sh. Ignored so a run never dirties the tree; commit
# one deliberately with `git add -f prey-report.json` when it is worth keeping.
device-report.json
device-digest.txt
prey-report.json
prey-digest.txt
budget.txt
files.txt.gz

# Game installs and data, wherever they get dropped
game/
gamedata/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Android / Gradle (for when the runtime lands)
.gradle/
build/
local.properties
*.apk
*.aab
*.keystore

# Native build
cmake-build-*/
compile_commands.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
