# Large binaries go through Git LFS — GitHub rejects files over 100 MB.
# Run `git lfs install` once per clone before adding anything matched here.

# Archives and game data
*.pak   filter=lfs diff=lfs merge=lfs -text
*.pck   filter=lfs diff=lfs merge=lfs -text
*.bnk   filter=lfs diff=lfs merge=lfs -text

# Executables and libraries under analysis
*.exe   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.apk   filter=lfs diff=lfs merge=lfs -text
*.aab   filter=lfs diff=lfs merge=lfs -text

# Extracted assets
*.dds   filter=lfs diff=lfs merge=lfs -text
*.cgf   filter=lfs diff=lfs merge=lfs -text
*.cga   filter=lfs diff=lfs merge=lfs -text
*.chr   filter=lfs diff=lfs merge=lfs -text
*.skin  filter=lfs diff=lfs merge=lfs -text
*.caf   filter=lfs diff=lfs merge=lfs -text

# Keep text diffable and consistent
*.py    text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.lua   text eol=lf
